# Backend API URL (with trailing slash)
# Example: https://seyfibaba.com/
NEXT_PUBLIC_BASE_URL=

# Next SSR (sunucu içi). Boş bırakın: canlıda http://127.0.0.1:3001/api (Next proxy) kullanılır.
# Yanlışlıkla :8000 verilip Laravel orada yoksa TÜM site düşer — o zaman bu satırı silin.
# NEXT_SERVER_BASE_URL=http://127.0.0.1:3001

# Application URL (frontend, no trailing slash)
NEXT_APPLICATION_URL=

# İkinci el subdomain (no trailing slash). 0 = kapalı (lokal acil durum)
NEXT_PUBLIC_SECOND_HAND_SUBDOMAIN=1
NEXT_PUBLIC_SECOND_HAND_ORIGIN=https://ikinciel.seyfibaba.com
NEXT_PUBLIC_MARKETPLACE_ORIGIN=https://seyfibaba.com
NEXT_PUBLIC_COOKIE_DOMAIN=.seyfibaba.com

# PWA Status (0=disabled, 1=enabled)
NEXT_PWA_STATUS=0

# Node environment (development | production)
NODE_ENV=production

# Port (default 3000)
PORT=3000

# next/image: 504 / yavaş optimizer için acil kaçış (1=kapalı, doğrudan src URL). Build sırasında okunur.
# NEXT_IMAGE_UNOPTIMIZED=1

# next/image: ek izinli hostlar (virgülle). admin/seyfibaba varsayılan olarak zaten ekli.
# NEXT_IMAGE_EXTRA_HOSTS=

# Sunucu tarafı (SSG/SSR) fetch'leri için iç ağ adresi.
# Build sırasında VPS'ten admin.seyfibaba.com'a erişilemiyorsa (hairpin NAT) bu değeri set edin.
# Örnek: NEXT_SERVER_BASE_URL=http://127.0.0.1:8000
# NEXT_SERVER_BASE_URL=

# Google Search Console doğrulama kodu (meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster doğrulama kodu
NEXT_PUBLIC_BING_VERIFICATION=

# Yandex Webmaster doğrulama kodu
NEXT_PUBLIC_YANDEX_VERIFICATION=

# On-demand revalidation secret (admin cache temizleme için)
# Sunucudaki .env dosyasına da ekleyin
REVALIDATE_SECRET=